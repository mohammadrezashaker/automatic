{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "automatic",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "b61921f5-1b8f-48aa-b56e-5b1e185a63e7","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "481ea9654f6d4c73b9577a1bf0800f47" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
